# Ground Zero environment.
# Copy to .env.local for local development. Never commit real secrets.

# --- Local development ---
# The app reads the seed Obsidian vault from this folder in development.
VAULT_DIR=./vault

# --- Production: git-backed Obsidian vault (next milestone) ---
# When GITHUB_VAULT_REPO is set, the app reads and writes the vault repo via the
# GitHub API, entirely from server routes. These never get a NEXT_PUBLIC prefix,
# so they stay out of the client bundle.
# GITHUB_VAULT_REPO=sam-evolv/groundzero-vault
# GITHUB_VAULT_BRANCH=main
# GITHUB_VAULT_TOKEN=        # fine-grained PAT, contents read/write on the vault repo only

# --- Auth gate (next milestone) ---
# Single-user gate. Server only.
# AUTH_SECRET=
