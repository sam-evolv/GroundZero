# Ground Zero environment.
# Copy to .env.local for local development. Never commit real secrets.

# --- Local development ---
# The app reads the seed Obsidian vault from this folder in development.
VAULT_DIR=./vault

# --- Production: vault over the GitHub API (reads and writes) ---
# The vault lives in /vault in this same repo, so point these at it. When set,
# the app reads and writes the vault via the GitHub API from server routes only.
# Never give these a NEXT_PUBLIC prefix.
# GITHUB_VAULT_REPO=sam-evolv/GroundZero
# GITHUB_VAULT_BRANCH=main
# GITHUB_VAULT_TOKEN=        # fine-grained PAT, contents read and write on this repo
# GITHUB_VAULT_BASE=vault    # folder holding the collections; set to "" if they live at the repo root

# --- Auth gate ---
# Single-user passcode gate. Set both to turn it on. AUTH_PASSCODE is what you
# type at /login; AUTH_SECRET signs the session cookie. Unset means open, which
# is for local dev only.
# AUTH_PASSCODE=
# AUTH_SECRET=

# --- Hermes council (the agent office) ---
# The council needs one model provider. NVIDIA is the free default (its API is
# OpenAI compatible). Without any provider key, Run council produces a clearly
# labeled dry run so the loop stays usable.
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # optional override
# HERMES_MODEL=meta/llama-3.3-70b-instruct              # optional; the NVIDIA model id
# Or use Anthropic instead (HERMES_MODEL then defaults to claude-opus-4-8):
# ANTHROPIC_API_KEY=
